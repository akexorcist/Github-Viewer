# Integration test configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit tokens.

# GitHub personal access token (classic or fine-grained with read:user, public_repo scopes)
# Without a token:  60 req/hour core, 10 req/min search (unauthenticated)
# With a token:    5000 req/hour core, 30 req/min search (authenticated)
GITHUB_TOKEN=

# Fixtures — the user/repo fetched in tests. Defaults below are used if unset.
GITHUB_TEST_USER=akexorcist
GITHUB_TEST_REPO=Github-Viewer
GITHUB_TEST_REPO_OWNER=akexorcist
